<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads the ground (landscape heights) from the player's own Satisfactory install.
       Build output and extracted data go under .local/terrain (game data is never committed). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../../../../.local/terrain/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../../../.local/terrain/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202609" />
  </ItemGroup>
</Project>
